{
  "uid": "passwords-overview",
  "title": "passwords.lan overview",
  "tags": ["passwords", "homelab", "vaultwarden"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "At a glance",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CPU usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 5 },
      "targets": [
        { "expr": "(1 - avg(rate(node_cpu_seconds_total{instance=\"10.120.22.10:9100\",mode=\"idle\"}[5m]))) * 100", "refId": "A", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Memory used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 5 },
      "targets": [
        { "expr": "(1 - node_memory_MemAvailable_bytes{instance=\"10.120.22.10:9100\"} / node_memory_MemTotal_bytes{instance=\"10.120.22.10:9100\"}) * 100", "refId": "A", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Disk used (/)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 5 },
      "targets": [
        { "expr": "(1 - node_filesystem_avail_bytes{instance=\"10.120.22.10:9100\",mountpoint=\"/\"} / node_filesystem_size_bytes{instance=\"10.120.22.10:9100\",mountpoint=\"/\"}) * 100", "refId": "A", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Vaultwarden TLS up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 5 },
      "targets": [
        { "expr": "probe_success{instance=\"https://passwords.lan\"}", "refId": "A", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Host resources",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU %",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 },
      "targets": [
        { "expr": "(1 - avg(rate(node_cpu_seconds_total{instance=\"10.120.22.10:9100\",mode=\"idle\"}[5m])) by (instance)) * 100", "refId": "A", "legendFormat": "cpu %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Memory %",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 },
      "targets": [
        { "expr": "(1 - node_memory_MemAvailable_bytes{instance=\"10.120.22.10:9100\"} / node_memory_MemTotal_bytes{instance=\"10.120.22.10:9100\"}) * 100", "refId": "A", "legendFormat": "mem %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Vaultwarden via synthetic probes",
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "passwords.lan probe duration",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "probe_duration_seconds{instance=\"https://passwords.lan\"}", "refId": "A", "legendFormat": "probe" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "passwords.lan TLS cert remaining (hours)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "(probe_ssl_earliest_cert_expiry{instance=\"https://passwords.lan\"} - time()) / 3600", "refId": "A", "legendFormat": "hours" }
      ],
      "fieldConfig": { "defaults": { "unit": "h", "decimals": 1 } }
    },
    {
      "id": 40,
      "type": "row",
      "title": "Recent cn-vaultwarden logs (LAN promtail)",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 41,
      "type": "logs",
      "title": "cn-vaultwarden container logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 25, "w": 24, "h": 12 },
      "targets": [
        { "expr": "{stack=\"cn-vaultwarden\", source=\"lan\"}", "refId": "A" }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none" }
    }
  ]
}
