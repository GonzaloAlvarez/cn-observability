# Step-ca host (hostname, not IP — step-ca cert SANs are step-ca,pki.lan,pki).
PKI_IP=pki.lan
ADMIN_EMAIL=

# LAN zone — must match cn-home's LAN_DOMAIN.
LAN_DOMAIN=kaiser.lan

# Kaiser's LAN IP. Used to bind LAN-only listeners (promtail syslog on
# 1514/tcp) — binding to 0.0.0.0 would conflict with the default-deny
# perimeter. Must match cn-home's KAISER_IP.
KAISER_IP=10.1.1.140

# Bootstrap admin password for Grafana. Re-applied on every restart.
GF_ADMIN_PASSWORD=

# SMTP for Alertmanager — leave blank to disable email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=

# Optional remote-write target (e.g. another Prometheus). Leave blank to disable.
REMOTE_WRITE_URL=

# Raidnas SNMPv2c community — mirror of the value in cn-root-docker/.env
# (must match what DSM Control Panel → Terminal & SNMP is configured for).
# snmp_exporter does not honor env var interpolation in its config;
# setup.sh envsubst-renders config/snmp-exporter/snmp.yml.tmpl → snmp.yml
# so the community is baked in at deploy time.
SNMP_RAIDNAS_COMMUNITY=

# pfSense SNMPv2c community — must match what pfSense Services → SNMP is
# configured with. Same envsubst-bake-at-deploy story as raidnas.
SNMP_PFSENSE_COMMUNITY=
