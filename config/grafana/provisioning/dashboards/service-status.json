{
  "uid": "service-status",
  "title": "Service status",
  "tags": ["homelab", "blackbox", "status"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Up / down — live state per probe target",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Probe success (last 24h)",
      "description": "One row per blackbox-{https,http} target. Green = probe_success == 1. Red = 0. The succession of bars over time IS the status page.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 1, "w": 24, "h": 14 },
      "targets": [
        { "expr": "probe_success{job=~\"blackbox-https|blackbox-http\"}", "refId": "A", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 0, "fillOpacity": 80 },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "alignValue": "left",
        "mergeValues": true,
        "rowHeight": 0.85,
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true }
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "Latency + 7-day uptime %",
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Probe latency (last 24h)",
      "description": "Wall-clock time to complete each probe — http GET + TLS handshake + TCP roundtrip. Spikes correlate to backend overload or network path issues.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 16, "h": 10 },
      "targets": [
        { "expr": "probe_duration_seconds{job=~\"blackbox-https|blackbox-http\"}", "refId": "A", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Uptime % (last 7 days)",
      "description": "100 * avg_over_time(probe_success[7d]) per target. >99 = green.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 10 },
      "targets": [
        { "expr": "100 * avg_over_time(probe_success{job=~\"blackbox-https|blackbox-http\"}[7d])", "refId": "A", "legendFormat": "{{instance}}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "TLS expiry — LAN step-ca targets only",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Hours until TLS cert expires",
      "description": "step-ca issues 24h leaves renewed daily by traefik, so this should oscillate between ~0h and ~24h. Anything stuck >25h means renewal is broken. The CertExpired alert in alerts.yml triggers if any value falls below 0.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 6 },
      "targets": [
        { "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-https\"} - time()) / 3600", "refId": "A", "legendFormat": "{{instance}}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "green", "value": 6 },
              { "color": "yellow", "value": 26 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Logs",
      "gridPos": { "x": 0, "y": 33, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "logs",
      "title": "blackbox-exporter recent log lines",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 10 },
      "targets": [
        { "expr": "{container=\"cn-observability-blackbox-exporter-1\"}", "refId": "A" }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
