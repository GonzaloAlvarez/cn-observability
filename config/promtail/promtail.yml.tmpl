server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: http://loki:3100/loki/api/v1/push

scrape_configs:
  - job_name: kaiser-containers
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
    relabel_configs:
      - source_labels: [__meta_docker_container_name]
        regex: /(.*)
        target_label: container
      - source_labels: [__meta_docker_container_label_com_docker_compose_project]
        target_label: project
      - source_labels: [__meta_docker_container_label_com_docker_compose_service]
        target_label: service
      - replacement: kaiser
        target_label: host

  - job_name: kaiser-journal
    journal:
      max_age: 12h
      path: /var/log/journal
      labels:
        job: kaiser-journal
        host: kaiser
    relabel_configs:
      - source_labels: ['__journal__systemd_unit']
        target_label: unit
      - source_labels: ['__journal__hostname']
        target_label: hostname

  # LAN syslog receiver. raidnas (Synology DS418) forwards DSM Log Center
  # events here over TCP/IETF (RFC 5424). The listener is gated by UFW
  # to the 10.120.26.0/24 subnet, and the docker port binding is pinned
  # to kaiser's LAN IP (KAISER_IP) — see docker-compose.yml.
  - job_name: lan-syslog
    syslog:
      listen_address: 0.0.0.0:1514
      listen_protocol: tcp
      idle_timeout: 60s
      label_structured_data: yes
      labels:
        job: lan-syslog
    relabel_configs:
      - source_labels: ['__syslog_message_hostname']
        target_label: host
      - source_labels: ['__syslog_message_severity']
        target_label: severity
      - source_labels: ['__syslog_message_facility']
        target_label: facility
      - source_labels: ['__syslog_message_app_name']
        target_label: unit
